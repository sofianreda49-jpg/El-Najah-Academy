# انسخ هذا الملف باسم .env واملأ القيم. لا ترفع .env على Git أبداً.
ENVIRONMENT=development

# رابط Supabase. لو الباسورد فيه رموز خاصة (@ : / # %) لازم تتحول (URL-encode).
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/postgres

# مفتاح التوقيع. ولّده بالأمر:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# اختياري (القيم الافتراضية مناسبة)
# MAX_FAILED_PER_IP=30
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5

# تسجيل الدخول بجوجل: الـ Client ID من Google Cloud Console (شكله xxxx.apps.googleusercontent.com)
GOOGLE_CLIENT_ID=

# تفعيل فوري لأدوار معينة بعد التسجيل بجوجل (اتركه فاضي = كل التسجيلات تستنى موافقتك)
# مثال: AUTO_APPROVE_ROLES=student,parent
AUTO_APPROVE_ROLES=
